---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Learning Hub', description = '私人学习笔记：路径、进度与资源。' } = Astro.props;
const pageTitle = title === 'Learning Hub' ? title : `${title} · Learning Hub`;
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={base}>Learning Hub</a>
        <nav class="nav" aria-label="主导航">
          <a href={base} aria-current={pathname === base || pathname === `${base}` ? 'page' : undefined}
            >书架</a
          >
          <a
            href={`${base}progress/`}
            aria-current={pathname.includes('/progress') ? 'page' : undefined}>进度</a
          >
          <a href={`${base}#search`}>搜索</a>
          <a href="https://github.com/cody1991/learning" target="_blank" rel="noopener noreferrer"
            >GitHub</a
          >
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
