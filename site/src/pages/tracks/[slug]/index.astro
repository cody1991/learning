---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { discoverTracks, getTrack, listTrackDocs, readTrackMarkdown } from '../../../lib/tracks';
import { renderMarkdown } from '../../../lib/markdown';

export function getStaticPaths() {
  return discoverTracks().map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('missing slug');

const track = getTrack(slug);
if (!track) throw new Error(`unknown track: ${slug}`);

const docs = listTrackDocs(slug);
const raw = readTrackMarkdown(slug, '');
if (raw == null) throw new Error(`missing README for ${slug}`);

const base = import.meta.env.BASE_URL;
const html = renderMarkdown(raw, slug, base);
---

<BaseLayout title={track.title} description={track.summary}>
  <div class="layout-doc">
    <aside class="side-nav">
      <h2>{track.title}</h2>
      <ul>
        {
          docs.map((doc) => {
            const href =
              doc.id === '' ? `${base}tracks/${slug}/` : `${base}tracks/${slug}/${doc.id}/`;
            return (
              <li>
                <a href={href} aria-current={doc.id === '' ? 'page' : undefined}>
                  {doc.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </aside>
    <article class="prose" data-pagefind-body set:html={html} />
  </div>
</BaseLayout>
